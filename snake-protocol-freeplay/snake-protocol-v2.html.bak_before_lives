<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>SNAKE//PROTOCOL v2 — RappiBellion Freeplay</title>
<style>
/* ═══════════════════════════════════════════════════════════
   SNAKE//PROTOCOL v2 — Cyberpunk data-serpent
   Paleta RappiBellion: #00FF41 / #00BCFF / #FF2D78
   ═══════════════════════════════════════════════════════════ */
:root{
  --neon-green:#00FF41;
  --neon-cyan:#00BCFF;
  --neon-pink:#FF2D78;
  --neon-gold:#FFD700;
  --bg-deep:#020604;
  --font-main:'Courier New',monospace;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;}
body{
  background:
    radial-gradient(ellipse at 50% -10%, rgba(0,255,65,.10), transparent 55%),
    radial-gradient(ellipse at 50% 115%, rgba(0,188,255,.08), transparent 55%),
    var(--bg-deep);
  color:#cfe9d6;
  font-family:var(--font-main);
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;
  user-select:none;-webkit-user-select:none;
}
#stage{
  position:relative;width:min(96vw,840px);
  max-height:98vh;display:flex;flex-direction:column;gap:6px;
}

/* ── HUD ─────────────────────────────────────────────── */
#hud{
  display:flex;align-items:center;justify-content:space-between;
  gap:8px;padding:7px 12px;
  border:1px solid rgba(0,255,65,.35);border-radius:4px;
  background:linear-gradient(180deg,rgba(0,255,65,.07),rgba(0,255,65,.02));
  box-shadow:0 0 14px rgba(0,255,65,.15), inset 0 0 18px rgba(0,255,65,.05);
  font-size:clamp(10px,1.6vw,13px);letter-spacing:.14em;text-transform:uppercase;
  flex-wrap:wrap;
}
.hud-item{display:flex;align-items:center;gap:6px;white-space:nowrap;}
.hud-label{color:rgba(0,255,65,.55);}
.hud-value{color:var(--neon-green);font-weight:bold;text-shadow:0 0 8px rgba(0,255,65,.8);min-width:3ch;}
#hudCombo{color:var(--neon-gold);text-shadow:0 0 8px rgba(255,215,0,.8);}
#hudCombo.hot{animation:comboPulse .5s ease-in-out infinite alternate;}
@keyframes comboPulse{from{transform:scale(1);}to{transform:scale(1.12);}}

/* power-up bar */
#puWrap{position:relative;height:5px;border-radius:3px;background:rgba(255,255,255,.06);overflow:hidden;flex:1 1 120px;min-width:90px;opacity:0;transition:opacity .25s;}
#puWrap.on{opacity:1;}
#puBar{position:absolute;inset:0;width:0%;border-radius:3px;transition:none;}
#puBar.overclock{background:linear-gradient(90deg,var(--neon-cyan),#7fe9ff);box-shadow:0 0 10px var(--neon-cyan);}
#puBar.firewall{background:linear-gradient(90deg,var(--neon-gold),#fff3b0);box-shadow:0 0 10px var(--neon-gold);}
#puBar.slowmo{background:linear-gradient(90deg,#b26bff,var(--neon-pink));box-shadow:0 0 10px #b26bff;}

/* ── ARENA ───────────────────────────────────────────── */
#arenaWrap{position:relative;line-height:0;border-radius:6px;overflow:hidden;
  border:1px solid rgba(0,255,65,.30);
  box-shadow:0 0 24px rgba(0,255,65,.18), inset 0 0 40px rgba(0,0,0,.6);}
canvas{width:100%;height:auto;display:block;background:#020604;}

/* scanlines + vignette (CSS overlay, no canvas cost) */
#fxOverlay{position:absolute;inset:0;pointer-events:none;z-index:3;
  background:repeating-linear-gradient(0deg,rgba(0,0,0,.16) 0 1px,transparent 1px 3px);
  mix-blend-mode:multiply;}
#fxOverlay::after{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at center,transparent 58%,rgba(0,0,0,.42) 100%);}

/* ── WHACKING DAY BOOST — splash portada + banner countdown ── */
#boostBanner{position:absolute;inset:0;z-index:4;pointer-events:none;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;
  background:radial-gradient(ellipse at center,rgba(255,215,0,.16),rgba(191,0,255,.09) 60%,transparent 82%);}
#boostBanner.hidden{display:none !important;}
#boostCover{width:min(46%,300px);border-radius:10px;border:3px solid var(--neon-gold);
  box-shadow:0 0 40px rgba(255,215,0,.85),0 0 90px rgba(255,45,120,.45);
  animation:coverZoom .55s cubic-bezier(.22,1.25,.36,1) both;}
@keyframes coverZoom{from{transform:scale(.15) rotate(-10deg);opacity:0;}to{transform:scale(1) rotate(0);opacity:1;}}
#boostTitle{font-family:'Orbitron','Courier New',monospace;font-weight:900;
  font-size:clamp(18px,4vw,34px);color:var(--neon-gold);letter-spacing:.18em;
  text-shadow:0 0 16px #FFD700,0 0 44px rgba(255,215,0,.5),3px 0 0 rgba(255,45,120,.6),-3px 0 0 rgba(0,188,255,.6);
  animation:titleGlitch 2s infinite steps(1);}
#boostSub{font-size:clamp(9px,1.6vw,12px);letter-spacing:.4em;color:#b26bff;text-transform:uppercase;text-shadow:0 0 10px #b26bff;}
#boostCount{font-family:'Orbitron',monospace;font-weight:900;font-size:clamp(22px,5vw,42px);
  color:#fff;text-shadow:0 0 18px var(--neon-gold);}
/* modo mini: splash → esquina con countdown */
#boostBanner.mini{background:none;flex-direction:row;justify-content:flex-start;align-items:center;padding:8px 10px;gap:8px;}
#boostBanner.mini #boostCover{width:56px;border-width:2px;animation:none;}
#boostBanner.mini #boostTitle{font-size:11px;letter-spacing:.14em;}
#boostBanner.mini #boostSub{display:none;}
#boostBanner.mini #boostCount{font-size:18px;color:var(--neon-gold);}

/* ── SCREENS ─────────────────────────────────────────── */
.screen{position:absolute;inset:0;z-index:5;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:14px;text-align:center;
  background:rgba(2,6,4,.88);backdrop-filter:blur(3px);line-height:1.5;
  padding:16px;}
.hidden{display:none !important;}

.title{
  font-family:'Orbitron','Courier New',monospace;
  font-size:clamp(22px,5vw,44px);font-weight:900;letter-spacing:.12em;
  color:var(--neon-green);
  text-shadow:0 0 12px rgba(0,255,65,.9),0 0 34px rgba(0,255,65,.45),3px 0 0 rgba(255,45,120,.55),-3px 0 0 rgba(0,188,255,.55);
  animation:titleGlitch 3.2s infinite steps(1);
}
@keyframes titleGlitch{
  0%,92%,100%{transform:translate(0);clip-path:none;}
  93%{transform:translate(-3px,1px);}
  95%{transform:translate(3px,-1px);}
  97%{transform:translate(-2px,0);}
}
.subtitle{font-size:clamp(10px,1.8vw,13px);letter-spacing:.42em;color:rgba(0,188,255,.85);text-transform:uppercase;}
.legend{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;font-size:clamp(9px,1.5vw,11px);letter-spacing:.08em;}
.legend span{padding:4px 9px;border:1px solid rgba(255,255,255,.14);border-radius:3px;background:rgba(255,255,255,.03);}
.lg-cyan{color:var(--neon-cyan);} .lg-gold{color:var(--neon-gold);} .lg-violet{color:#b26bff;} .lg-red{color:var(--neon-pink);}
.blink{animation:blinkA 1.1s steps(2) infinite;color:var(--neon-green);letter-spacing:.3em;font-size:clamp(11px,2vw,15px);text-transform:uppercase;}
@keyframes blinkA{50%{opacity:.15;}}
.smallprint{font-size:9px;letter-spacing:.22em;color:rgba(255,255,255,.28);text-transform:uppercase;}

.btn{
  font-family:inherit;font-size:clamp(11px,1.8vw,14px);letter-spacing:.25em;text-transform:uppercase;
  color:var(--neon-green);background:transparent;cursor:pointer;
  border:1px solid rgba(0,255,65,.6);border-radius:3px;padding:10px 26px;
  box-shadow:0 0 12px rgba(0,255,65,.25), inset 0 0 12px rgba(0,255,65,.07);
  transition:all .15s;
}
.btn:hover{background:rgba(0,255,65,.12);box-shadow:0 0 22px rgba(0,255,65,.5);transform:translateY(-1px);}
.btn:active{transform:scale(.97);}

/* game over stats */
#goStats{display:grid;grid-template-columns:auto auto;gap:4px 22px;font-size:clamp(10px,1.7vw,13px);letter-spacing:.12em;text-transform:uppercase;}
#goStats b{color:var(--neon-green);text-align:right;text-shadow:0 0 8px rgba(0,255,65,.7);}
#goTitle{font-family:'Orbitron',monospace;font-size:clamp(20px,4.4vw,36px);font-weight:900;letter-spacing:.14em;color:var(--neon-pink);
  text-shadow:0 0 14px rgba(255,45,120,.9),0 0 40px rgba(255,45,120,.4);}
#goNew{color:var(--neon-gold);letter-spacing:.3em;font-size:clamp(11px,1.9vw,14px);text-shadow:0 0 12px rgba(255,215,0,.9);animation:comboPulse .6s ease-in-out infinite alternate;}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important;}
}

/* ── AA v3: SCORE POP — el puntaje respira cuando sube ── */
#hScore.pop{animation:scorePop .5s cubic-bezier(.18,1.6,.4,1);}
#hScore.pop.big{animation:scorePopBig .65s cubic-bezier(.18,1.6,.4,1);}
@keyframes scorePop{
  0%{transform:scale(1);}
  30%{transform:scale(1.5);color:#ffffff;text-shadow:0 0 18px var(--neon-green),0 0 38px rgba(0,255,65,.65);}
  100%{transform:scale(1);}
}
@keyframes scorePopBig{
  0%{transform:scale(1);}
  22%{transform:scale(1.95);color:#FFD700;text-shadow:0 0 24px var(--neon-gold),0 0 52px rgba(255,215,0,.75);}
  100%{transform:scale(1);}
}

</style>
</head>
<body>
<div id="stage">
  <div id="hud">
    <div class="hud-item"><span class="hud-label">SCORE</span><span class="hud-value" id="hScore">0</span></div>
    <div class="hud-item"><span class="hud-label">HI</span><span class="hud-value" id="hHi">0</span></div>
    <div class="hud-item"><span class="hud-label">COMBO</span><span class="hud-value" id="hudCombo">x1</span></div>
    <div class="hud-item" style="flex:1 1 auto;"><div id="puWrap"><div id="puBar"></div></div></div>
    <div class="hud-item"><span class="hud-label">LEN</span><span class="hud-value" id="hLen">4</span></div>
  </div>

  <div id="arenaWrap">
    <canvas id="cv" width="840" height="600"></canvas>
    <div id="fxOverlay"></div>

    <!-- WHACKING DAY BOOST — splash de portada + countdown -->
    <div id="boostBanner" class="hidden">
      <img id="boostCover" src="../juegos beta/snake.PNG" alt=""
           onerror="this.onerror=null;this.src='../images/snake.PNG';">
      <div id="boostTitle">&#9889; WHACKING DAY &#9889;</div>
      <div id="boostSub">Barry White Mode &middot; Inmunidad Total</div>
      <div id="boostCount">30s</div>
    </div>

    <!-- INTRO -->
    <div class="screen" id="scIntro">
      <div class="title">SNAKE//PROTOCOL</div>
      <div class="subtitle">Intranet Infiltration &middot; v2.0</div>
      <div class="legend">
        <span class="lg-cyan">&#9670; OVERCLOCK</span>
        <span class="lg-gold">&#9670; FIREWALL</span>
        <span class="lg-violet">&#9670; SLOW-MO</span>
        <span class="lg-red">&#9632; SECURITY NODES</span>
        <span class="lg-gold">&#9733; CHERRY BONUS +100</span>
      </div>
      <button class="btn" id="btnStart">INICIAR INFILTRACI&Oacute;N</button>
      <div class="blink" id="introBlink">PRESS ENTER // TAP TO START</div>
      <div class="smallprint">WASD / FLECHAS / SWIPE &middot; P = PAUSA</div>
    </div>

    <!-- PAUSE -->
    <div class="screen hidden" id="scPause">
      <div class="title" style="font-size:clamp(18px,3.6vw,30px);">// PAUSA //</div>
      <div class="subtitle">Conexi&oacute;n en standby</div>
      <button class="btn" id="btnResume">REANUDAR [P]</button>
    </div>

    <!-- GAME OVER -->
    <div class="screen hidden" id="scOver">
      <div id="goTitle">CONEXI&Oacute;N PERDIDA</div>
      <div id="goNew" class="hidden">&#9733; NEW RECORD &#9733;</div>
      <div id="goStats">
        <span>SCORE</span><b id="goScore">0</b>
        <span>PACKETS</span><b id="goPackets">0</b>
        <span>MAX COMBO</span><b id="goCombo">x1</b>
        <span>LONGITUD</span><b id="goLen">4</b>
        <span>TIEMPO</span><b id="goTime">0s</b>
      </div>
      <button class="btn" id="btnRetry">REINTENTAR [ENTER]</button>
      <div class="smallprint">El protocolo nunca muere. Solo se reconecta.</div>
    </div>
  </div>
</div>

<script>
'use strict';
/* ═══════════════════════════════════════════════════════════
   SNAKE//PROTOCOL v2 — engine
   Delta-time fixed-step loop + render interpolation.
   ═══════════════════════════════════════════════════════════ */

// ── Config ────────────────────────────────────────────────
const COLS=28, ROWS=20, CELL=30;
const W=COLS*CELL, H=ROWS*CELL;
const STEP_BASE=150, STEP_MIN=76, STEP_DECAY=1.6;   // ms por celda
const COMBO_WINDOW=4000, COMBO_MAX=5;
const PU_DURATION=5200;
const BOOST_DURATION=30000;                         // WHACKING DAY: 30s sincronizados con simpson-boost.mp3
const OBSTACLE_MAX=12, OBSTACLE_EVERY=60;           // 1 nodo cada N puntos
const LS_KEY='snakeProtocolHighScore_v2';

// ═══════════════ AA v3 — CHERRY BONUS + SPRITE BANK ═══════════════
const CHERRY_PTS=100, CHERRY_EVERY_MIN=38000, CHERRY_EVERY_RAND=22000, CHERRY_LIFE=6000;

const ASSET_DIR='assets/';
const SPRITES={};
const SPRITE_LIST=['apple','cherry',
  'snake_head','snake_body','snake_tail',
  'snake_speed_head','snake_speed_body','snake_speed_tail',
  'snake_invincible_head','snake_invincible_body','snake_invincible_tail',
  'snake_slow_head','snake_slow_body','snake_slow_tail','snake_dead'];
(function preloadSprites(){
  for(const nm of SPRITE_LIST){
    const img=new Image();
    img.onload=()=>{ SPRITES[nm].ok=true; };
    img.onerror=()=>{};               // sprite ausente → fallback vectorial silencioso
    img.src=ASSET_DIR+nm+'.png';
    SPRITES[nm]={img,ok:false};
  }
})();
// API pública de integración/depuración: constante `const` no cuelga de window,
// pero probes (Playwright) y futuros módulos pueden necesitar leerlas.
Object.assign(window,{SPRITES,CHERRY_PTS,CHERRY_LIFE,CHERRY_EVERY_MIN,CHERRY_EVERY_RAND});

// ── Canvas ────────────────────────────────────────────────
const cv=document.getElementById('cv');
const ctx=cv.getContext('2d');

// ── Estado ────────────────────────────────────────────────
const S={
  mode:'intro',            // intro | playing | paused | dying | over
  snake:[], prevSnake:[], dir:{x:1,y:0}, queue:[],
  foods:[], obstacles:[], particles:[], popups:[],
  score:0, hi:+(localStorage.getItem(LS_KEY)||0),
  packets:0, comboChain:0, comboMult:1, lastEatAt:-1e9, maxCombo:1,
  stepMs:STEP_BASE, acc:0,
  pu:{overclock:0,firewall:0,slowmo:0,boost:0},   // timestamps de expiración (performance.now)
  startedAt:0, elapsedMs:0,
  shakeT:0, shakeMag:0,
  deathAt:0, newRecord:false,
  timeScale:1,
  aiSnakes:[],             // serpientes IA decorativas del boost
  _boostWasActive:false,
  _lastVariant:'',         // AA: variante sprite activa ('','_speed','_invincible','_slow')
  _variantFlash:0,         // AA: timestamp del último cambio de variante (flash transición)
  nextCherryAt:0,          // AA: próximo spawn de CHERRY BONUS (performance.now)
  rings:[]                 // AA: shockwaves anulares al comer
};

// ── DOM refs ──────────────────────────────────────────────
const $=id=>document.getElementById(id);
const hScore=$('hScore'), hHi=$('hHi'), hudCombo=$('hudCombo'), hLen=$('hLen'),
      puWrap=$('puWrap'), puBar=$('puBar'),
      scIntro=$('scIntro'), scPause=$('scPause'), scOver=$('scOver');

// ═══════════════ AUDIO (WebAudio, sin archivos) ════════════
let AC=null;
function audio(){ if(!AC){ try{AC=new (window.AudioContext||window.webkitAudioContext)();}catch(e){} } if(AC&&AC.state==='suspended')AC.resume(); return AC; }
function tone(freq,dur,type='square',vol=.08,slideTo=null){
  const ac=audio(); if(!ac)return;
  const o=ac.createOscillator(),g=ac.createGain();
  o.type=type;o.frequency.value=freq;
  if(slideTo)o.frequency.exponentialRampToValueAtTime(slideTo,ac.currentTime+dur);
  g.gain.setValueAtTime(vol,ac.currentTime);
  g.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+dur);
  o.connect(g).connect(ac.destination);
  o.start();o.stop(ac.currentTime+dur+.02);
}
const sfx={
  eat(m){ tone(420+m*70,.09,'square',.09); setTimeout(()=>tone(620+m*90,.07,'square',.06),60); },
  power(){ tone(300,.12,'sawtooth',.07,900); setTimeout(()=>tone(900,.14,'square',.06,1400),110); },
  die(){ tone(220,.5,'sawtooth',.12,40); setTimeout(()=>tone(160,.6,'square',.09,30),120); },
  start(){ tone(240,.08,'square',.07); setTimeout(()=>tone(360,.08,'square',.07),90); setTimeout(()=>tone(520,.12,'square',.08),180); },
  turn(){ tone(980,.03,'square',.02); }
};

// ═══════════════ HELPERS DE GRID ═══════════════════════════
const key=(x,y)=>y*COLS+x;
function occupied(x,y){
  return S.snake.some(s=>s.x===x&&s.y===y) ||
         S.foods.some(f=>f.x===x&&f.y===y) ||
         S.obstacles.some(o=>o.x===x&&o.y===y);
}
function freeCell(minHeadDist=0){
  for(let i=0;i<400;i++){
    const x=(Math.random()*COLS)|0, y=(Math.random()*ROWS)|0;
    if(occupied(x,y))continue;
    if(minHeadDist&&S.snake.length){
      const h=S.snake[0];
      if(Math.abs(h.x-x)+Math.abs(h.y-y)<minHeadDist)continue;
    }
    return {x,y};
  }
  return null;
}

// ═══════════════ FOODS ═════════════════════════════════════
const FOOD_TYPES=[
  {kind:'packet', pts:10, color:'#00BCFF', weight:100},
  {kind:'overclock',pts:40,color:'#00BCFF',weight:14},
  {kind:'firewall', pts:50,color:'#FFD700',weight:9},
  {kind:'slowmo',   pts:30,color:'#b26bff',weight:12}
];
function spawnFood(forceKind){
  let pool=FOOD_TYPES.filter(f=>{
    if(f.kind==='packet')return true;
    if(S.score<50)return false;
    return Math.random()< f.weight/100;
  });
  let t;
  if(forceKind)t=FOOD_TYPES.find(f=>f.kind===forceKind);
  else{
    const tot=pool.reduce((a,f)=>a+f.weight,0);
    let r=Math.random()*tot;
    t=pool[0]; for(const f of pool){ r-=f.weight; if(r<=0){t=f;break;} }
  }
  const c=freeCell(4); if(c)S.foods.push({...c,...t,born:performance.now()});
}

// ═══════════════ OBSTÁCULOS (security nodes) ═══════════════
function maybeSpawnObstacle(){
  const want=Math.min(OBSTACLE_MAX,Math.floor(S.score/OBSTACLE_EVERY));
  while(S.obstacles.length<want){
    const c=freeCell(6); if(!c)break;
    S.obstacles.push({...c,born:performance.now()});
  }
}

// ═══════════════ CICLO DE PARTIDA ══════════════════════════
function resetGame(){
  const cy=(ROWS/2)|0;
  S.snake=[{x:8,y:cy},{x:7,y:cy},{x:6,y:cy},{x:5,y:cy}];
  S.prevSnake=S.snake.map(s=>({...s}));
  S.dir={x:1,y:0}; S.queue=[];
  S.foods=[]; S.obstacles=[]; S.particles=[]; S.popups=[];
  S.score=0; S.packets=0; S.comboChain=0; S.comboMult=1; S.maxCombo=1;
  S.lastEatAt=-1e9; S.stepMs=STEP_BASE; S.acc=0;
  S.pu={overclock:0,firewall:0,slowmo:0,boost:0};
  S.shakeT=0; S.newRecord=false; S.timeScale=1;
  S.aiSnakes=[]; S._boostWasActive=false;
  S._lastVariant=''; S._variantFlash=0;
  S.nextCherryAt=0; S.rings=[];
  hideBoostBanner();
  spawnFood(); spawnFood();
  updateHUD();
}
function startGame(){
  resetGame();
  S.mode='playing'; S.startedAt=performance.now();
  scIntro.classList.add('hidden'); scPause.classList.add('hidden'); scOver.classList.add('hidden');
  sfx.start();
  postParent({type:'FP_GAME_STATE',state:'start'});
}
function togglePause(){
  if(S.mode==='playing'){ S.mode='paused'; scPause.classList.remove('hidden'); postParent({type:'FP_GAME_STATE',state:'pause'}); }
  else if(S.mode==='paused'){ S.mode='playing'; scPause.classList.add('hidden'); postParent({type:'FP_GAME_STATE',state:'resume'}); }
}

function gameOver(){
  S.mode='dying'; S.deathAt=performance.now();
  sfx.die();
  burst(S.snake[0].x,S.snake[0].y,'#FF2D78',46);
  S.shakeT=650; S.shakeMag=9;
  if(S.score>S.hi){ S.hi=S.score; S.newRecord=true; localStorage.setItem(LS_KEY,String(S.hi)); }
  postParent({type:'FP_GAME_STATE',state:'gameover'});
  postParent({type:'GAME_OVER'});
  setTimeout(showGameOver,950);
}
function showGameOver(){
  S.mode='over';
  $('goScore').textContent=S.score;
  $('goPackets').textContent=S.packets;
  $('goCombo').textContent='x'+S.maxCombo;
  $('goLen').textContent=S.snake.length;
  $('goTime').textContent=(S.elapsedMs/1000).toFixed(1)+'s';
  $('goNew').classList.toggle('hidden',!S.newRecord);
  scOver.classList.remove('hidden');
  updateHUD();
}

// ═══════════════ STEP LÓGICO ═══════════════════════════════
function step(){
  S.prevSnake=S.snake.map(s=>({x:s.x,y:s.y}));

  // consumir cola de giros
  while(S.queue.length){
    const d=S.queue.shift();
    if(d.x!==-S.dir.x||d.y!==-S.dir.y){ S.dir=d; break; }
  }

  const now=performance.now();
  const firewall=S.pu.firewall>now;
  const boostOn=S.pu.boost>now;          // WHACKING DAY: inmunidad total
  let nx=S.snake[0].x+S.dir.x, ny=S.snake[0].y+S.dir.y;

  if(firewall||boostOn){ nx=(nx+COLS)%COLS; ny=(ny+ROWS)%ROWS; }
  else if(nx<0||nx>=COLS||ny<0||ny>=ROWS){ gameOver(); return; }

  const hitSelf=!boostOn&&S.snake.some((s,i)=>i<S.snake.length-1&&s.x===nx&&s.y===ny);
  let hitObs=S.obstacles.some(o=>o.x===nx&&o.y===ny);
  if(boostOn&&hitObs){ whackObstacle(nx,ny); hitObs=false; }  // Barry White aplasta el nodo
  if(hitSelf||hitObs){ gameOver(); return; }

  S.snake.unshift({x:nx,y:ny});

  // ¿comió?
  const fi=S.foods.findIndex(f=>f.x===nx&&f.y===ny);
  if(fi>=0){
    const f=S.foods.splice(fi,1)[0];
    eatFood(f,now);
  }else{
    S.snake.pop();
  }
}

function eatFood(f,now){
  const isCherry=f.kind==='cherry';

  // combo (la cherry paga fijo y NO manipula la cadena de combo)
  if(!isCherry){
    if(now-S.lastEatAt<COMBO_WINDOW)S.comboChain++; else S.comboChain=1;
    S.comboMult=Math.min(COMBO_MAX,S.comboChain);
    S.maxCombo=Math.max(S.maxCombo,S.comboMult);
  }else{
    if(now-S.lastEatAt>=COMBO_WINDOW){S.comboChain=1;S.comboMult=1;}
  }
  S.lastEatAt=now;

  const gained=isCherry?CHERRY_PTS:f.pts*S.comboMult;
  S.score+=gained; if(!isCherry)S.packets++;

  // ═══ AA v3 — FEEDBACK ESCALONADO POR MAGNITUD ═══
  const isBig=gained>=50||isCherry;
  const fxCol=isCherry?'#FFD700':(gained>=50?'#FFD700':gained>=30?'#b26bff':f.color);
  popText(isCherry?('\u2605 +'+gained+' \u2605'):('+'+gained+(S.comboMult>1?' x'+S.comboMult:'')),
          f.x,f.y,fxCol,{big:isBig});
  burst(f.x,f.y,isCherry?'#FF2D78':f.color,isCherry?30:14);
  // shockwave anular jugosa
  S.rings.push({x:f.x*CELL+CELL/2,y:f.y*CELL+CELL/2,r:6,
                spd:isBig?4.6:2.8,life:1,
                color:isCherry?'255,215,0':'0,255,65',
                lw:isBig?3.5:2});
  // micro-shake proporcional + vibración táctil
  if(gained>10||isCherry){
    S.shakeT=Math.max(S.shakeT,isCherry?330:200);
    S.shakeMag=Math.max(S.shakeMag,isCherry?7:(gained>=40?4:2));
  }
  if(navigator.vibrate&&(isCherry||gained>=40)){ try{navigator.vibrate(isCherry?45:15);}catch(e){} }
  hudScorePop(gained);                                   // SCORE en HUD pulsa (CSS keyframes)
  if(isCherry)sfx.power(); else sfx.eat(S.comboMult);

  if(f.kind==='overclock')S.pu.overclock=now+PU_DURATION;
  if(f.kind==='firewall') S.pu.firewall =now+PU_DURATION;
  if(f.kind==='slowmo')   S.pu.slowmo   =now+PU_DURATION;

  // dificultad (la cherry no endurece el juego ni cuenta como packet)
  if(!isCherry)S.stepMs=Math.max(STEP_MIN,STEP_BASE-S.packets*STEP_DECAY);
  if(isCherry)spawnFood();                               // repone la apple tragada
  else{
    spawnFood();
    if(Math.random()<.35)spawnFood();
  }
  maybeSpawnObstacle();
  updateHUD();
  // Arena sync: SCORE_UPDATE es el formato que consume index.html;
  // SCORE se mantiene por retrocompatibilidad.
  postParent({type:'SCORE_UPDATE',score:S.score});
  postParent({type:'SCORE',score:S.score});
  // CHAOS_LEVEL escala 0–100 (paridad Pac-Hack/Tetris):
  // arranca en 20, sube ~2 pts por packet, techo 100.
  postParent({type:'CHAOS_LEVEL',level:Math.min(100,20+S.packets*2)});
}

// ═══════════════ BOOST — WHACKING DAY MODE ═════════════════
const AI_COLORS=['#FF2D78','#00BCFF','#BF00FF','#FF6B00','#7CFFE8'];
function activateSnakeBoost(){
  S.pu.boost=performance.now()+BOOST_DURATION;
  spawnAiSnakes();
  showBoostSplash();
  sfxWhack();
  postParent({type:'BOOST_USED'});
}
function sfxWhack(){
  tone(160,.25,'sawtooth',.10,520);
  setTimeout(()=>tone(520,.2,'square',.08,1040),180);
  setTimeout(()=>tone(1040,.3,'triangle',.07,2080),380);
}
function showBoostSplash(){
  const b=$('boostBanner'); if(!b)return;
  b.classList.remove('hidden','mini');
  clearTimeout(b._miniTimer);
  b._miniTimer=setTimeout(()=>b.classList.add('mini'),1900);
}
function hideBoostBanner(){
  const b=$('boostBanner'); if(!b)return;
  b.classList.add('hidden'); b.classList.remove('mini');
  clearTimeout(b._miniTimer);
}
function spawnAiSnakes(){
  S.aiSnakes=[];
  const count=3+((Math.random()*3)|0);
  for(let i=0;i<count;i++){
    const len=4+((Math.random()*6)|0);
    const sx=(Math.random()*COLS)|0, sy=(Math.random()*ROWS)|0;
    const D=[[1,0],[-1,0],[0,1],[0,-1]], d=D[(Math.random()*4)|0];
    const segs=[];
    for(let j=0;j<len;j++)segs.push({x:(sx-d[0]*j+COLS)%COLS,y:(sy-d[1]*j+ROWS)%ROWS});
    S.aiSnakes.push({segs,dir:{x:d[0],y:d[1]},color:AI_COLORS[i%AI_COLORS.length],
                     acc:Math.random()*120,interval:105+Math.random()*95,
                     scale:.5+Math.random()*.38});
  }
}
function updateAiSnakes(dt){
  for(const a of S.aiSnakes){
    a.acc+=dt;
    while(a.acc>=a.interval){
      a.acc-=a.interval;
      if(Math.random()<.32){
        const O=[[1,0],[-1,0],[0,1],[0,-1]].filter(d=>!(d[0]===-a.dir.x&&d[1]===-a.dir.y));
        const d=O[(Math.random()*O.length)|0];
        a.dir={x:d[0],y:d[1]};
      }
      const h=a.segs[0];
      a.segs.unshift({x:(h.x+a.dir.x+COLS)%COLS,y:(h.y+a.dir.y+ROWS)%ROWS});
      a.segs.pop();
    }
  }
}
function clearAiSnakes(){
  for(const a of S.aiSnakes){ const h=a.segs[0]; if(h)burst(h.x,h.y,a.color,12); }
  S.aiSnakes=[];
}
function whackObstacle(gx,gy){
  const oi=S.obstacles.findIndex(o=>o.x===gx&&o.y===gy);
  if(oi<0)return;
  S.obstacles.splice(oi,1);
  S.score+=25;
  burst(gx,gy,'#FFD700',26);
  popText('+WHACKED!',gx,gy,'#FFD700');
  sfxWhack();
  updateHUD();
  postParent({type:'SCORE',score:S.score});
}
function updateBoost(now,dt){
  const active=S.pu.boost>now;
  if(!active&&S._boostWasActive){ clearAiSnakes(); hideBoostBanner(); }
  S._boostWasActive=active;
  if(active){
    updateAiSnakes(dt);
    const cEl=$('boostCount');
    if(cEl)cEl.textContent=Math.ceil((S.pu.boost-now)/1000)+'s';
    // estela de chispas doradas tras la cola
    if(Math.random()<.3&&S.snake.length){
      const t=S.snake[S.snake.length-1];
      S.particles.push({x:t.x*CELL+CELL/2+(Math.random()-.5)*CELL*.6,
                        y:t.y*CELL+CELL/2+(Math.random()-.5)*CELL*.6,
                        vx:(Math.random()-.5)*.8,vy:-.4-Math.random()*.8,
                        life:1,decay:.02,color:'#FFD700',size:2+Math.random()*2});
    }
  }
}

// ═══════════════ FX ════════════════════════════════════════
function burst(gx,gy,color,n){
  const cx=gx*CELL+CELL/2, cy=gy*CELL+CELL/2;
  for(let i=0;i<n;i++){
    const a=Math.random()*Math.PI*2, sp=1+Math.random()*3.4;
    S.particles.push({x:cx,y:cy,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,life:1,decay:.016+Math.random()*.02,color,size:2+Math.random()*3});
  }
}
function popText(text,gx,gy,color,opts){
  opts=opts||{};
  S.popups.push({text,x:gx*CELL+CELL/2,y:gy*CELL+CELL/2,life:1,color,
                 big:!!opts.big,wob:Math.random()*Math.PI*2});
}
function updateFx(dt){
  const k=dt/16.67;
  for(const p of S.particles){ p.x+=p.vx*k; p.y+=p.vy*k; p.vy+=.04*k; p.life-=p.decay*k; }
  S.particles=S.particles.filter(p=>p.life>0);
  for(const p of S.popups){
    p.y-=(p.big?.85:.55)*k;
    p.wob=(p.wob||0)+.06*k;
    p.life-=(p.big?.011:.017)*k;   // los BIG flotan más tiempo
  }
  S.popups=S.popups.filter(p=>p.life>0);
  for(const r of S.rings){ r.r+=r.spd*k; r.life-=.055*k; }
  S.rings=S.rings.filter(r=>r.life>0);
  if(S.shakeT>0)S.shakeT-=dt;
}

// ═══════════════ RENDER ════════════════════════════════════
let gridPattern=null;
function buildGrid(){
  const off=document.createElement('canvas'); off.width=W; off.height=H;
  const g=off.getContext('2d');
  g.fillStyle='#020604'; g.fillRect(0,0,W,H);
  g.strokeStyle='rgba(0,255,65,.055)'; g.lineWidth=1;
  g.beginPath();
  for(let x=1;x<COLS;x++){ g.moveTo(x*CELL+.5,0); g.lineTo(x*CELL+.5,H); }
  for(let y=1;y<ROWS;y++){ g.moveTo(0,y*CELL+.5); g.lineTo(W,y*CELL+.5); }
  g.stroke();
  // nodos de esquina decorativos
  g.fillStyle='rgba(0,188,255,.10)';
  [[0,0],[W-CELL,0],[0,H-CELL],[W-CELL,H-CELL]].forEach(([x,y])=>g.fillRect(x,y,CELL,CELL));
  gridPattern=off;
}
buildGrid();

function lerp(a,b,t){return a+(b-a)*t;}

function segRenderPos(i,t){
  const cur=S.snake[i], prev=S.prevSnake[i]||cur;
  // teleport (firewall wrap): snap sin interpolar
  if(Math.abs(cur.x-prev.x)>1||Math.abs(cur.y-prev.y)>1)return {x:cur.x,y:cur.y};
  return {x:lerp(prev.x,cur.x,t), y:lerp(prev.y,cur.y,t)};
}

function render(t){
  ctx.save();
  if(S.shakeT>0){
    const m=S.shakeMag*(S.shakeT/650);
    ctx.translate((Math.random()-.5)*m,(Math.random()-.5)*m);
  }
  ctx.drawImage(gridPattern,0,0);

  const now=performance.now();

  // ── obstáculos: security nodes ──
  for(const o of S.obstacles){
    const age=Math.min(1,(now-o.born)/400);
    const cx=o.x*CELL+CELL/2, cy=o.y*CELL+CELL/2, r=CELL*.36*age;
    ctx.save();
    ctx.shadowColor='#FF2D78'; ctx.shadowBlur=10;
    ctx.fillStyle='#FF2D78';
    ctx.beginPath(); ctx.arc(cx,cy,r,0,Math.PI*2); ctx.fill();
    ctx.shadowBlur=0;
    ctx.fillStyle='rgba(255,255,255,.75)';
    ctx.beginPath(); ctx.arc(cx,cy,r*.38,0,Math.PI*2); ctx.fill();
    // anillo rotatorio
    ctx.strokeStyle='rgba(255,45,120,.5)'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.arc(cx,cy,r+4,now/500,now/500+Math.PI*1.2); ctx.stroke();
    ctx.restore();
  }

  // ── foods AA: FRUTAS GRANDES (apple base / cherry bonus) + diamantes power-up ──
  for(const f of S.foods){
    const cx=f.x*CELL+CELL/2, cy=f.y*CELL+CELL/2;
    const fruit=f.kind==='packet'?'apple':(f.kind==='cherry'?'cherry':null);
    if(fruit){
      const sp=SPRITES[fruit];
      const bobA=Math.sin(now/300+f.born/131);
      const grow=.75+.25*Math.min(1,(now-f.born)/180);        // pop-in al aparecer
      const size=CELL*(fruit==='cherry'?1.62:1.46)*(1+bobA*.05)*grow;
      if(sp.ok){
        // halo neón expandido detrás de la fruta (doble draw barato)
        ctx.save();
        ctx.shadowColor=fruit==='cherry'?'#FF2D78':'#00FF41';
        ctx.shadowBlur=20;
        ctx.globalAlpha=.35;
        ctx.drawImage(sp.img,cx-size*.62,cy+bobA*2.5-size*.62,size*1.24,size*1.24);
        ctx.globalAlpha=1;
        ctx.drawImage(sp.img,cx-size/2,cy+bobA*2.5-size/2,size,size);
        ctx.restore();
      }else{
        /* FALLBACK vectorial si los assets no cargaron */
        const r=CELL*.32*(1+Math.sin(now/180+f.born/99)*.12);
        ctx.save();
        ctx.translate(cx,cy);ctx.rotate(now/900);
        ctx.shadowColor=f.color;ctx.shadowBlur=14;
        ctx.fillStyle=fruit==='cherry'?'#FF2D78':f.color;
        ctx.beginPath();
        ctx.moveTo(0,-r);ctx.lineTo(r,0);ctx.lineTo(0,r);ctx.lineTo(-r,0);
        ctx.closePath();ctx.fill();
        ctx.restore();
      }
      // anillo countdown dorado EXCLUSIVO de la cherry (tiempo restante)
      if(fruit==='cherry'&&f.diesAt){
        const fr=Math.max(0,(f.diesAt-now)/CHERRY_LIFE);
        ctx.save();
        ctx.strokeStyle='rgba(255,215,0,'+(.55+.35*Math.sin(now/110)).toFixed(2)+')';
        ctx.lineWidth=2.5;
        ctx.beginPath();
        ctx.arc(cx,cy,CELL*.95+5,-Math.PI/2,-Math.PI/2+fr*Math.PI*2);
        ctx.stroke();
        ctx.restore();
      }
      continue;
    }
    // power-ups originales como diamantes neón (sin sprite equivalente en el pack)
    const pulse=1+Math.sin(now/180+f.born/99)*.12;
    const r=CELL*.32*pulse;
    ctx.save();
    ctx.translate(cx,cy); ctx.rotate(now/900);
    ctx.shadowColor=f.color; ctx.shadowBlur=14;
    ctx.fillStyle=f.color;
    ctx.beginPath();
    ctx.moveTo(0,-r);ctx.lineTo(r,0);ctx.lineTo(0,r);ctx.lineTo(-r,0);
    ctx.closePath(); ctx.fill();
    ctx.shadowBlur=0;
    ctx.fillStyle='rgba(255,255,255,.85)';
    ctx.fillRect(-r*.18,-r*.18,r*.36,r*.36);
    ctx.restore();
  }

  // ── serpientes IA del boost (detrás del jugador) ──
  if(S.pu.boost>now)drawAiSnakes();

  // ── snake AA: sprites por variante de estado (+ fallback vectorial) ──
  const n=S.snake.length;
  const firewall=S.pu.firewall>now;
  const boostOn=S.pu.boost>now;
  let variant='';
  if(boostOn||firewall)variant='_invincible';
  else if(S.pu.overclock>now)variant='_speed';
  else if(S.pu.slowmo>now)variant='_slow';
  if(variant!==S._lastVariant){ S._lastVariant=variant; S._variantFlash=now; }
  const variantHot=(now-(S._variantFlash||0))<170;   // flash blanco al cambiar de estado

  for(let i=n-1;i>=0;i--){
    const p=segRenderPos(i,t);
    const px=p.x*CELL, py=p.y*CELL;
    const head=i===0;
    const frac=i/Math.max(n-1,1);
    const dyingHead=head&&S.mode==='dying';
    const sprName=dyingHead?'snake_dead'
                  :head?('snake'+variant+'_head')
                  :(i===n-1?('snake'+variant+'_tail')
                           :('snake'+variant+'_body'));
    const img=(SPRITES[sprName]&&SPRITES[sprName].ok)?SPRITES[sprName].img:null;
    if(img){
      const size=CELL*(head?(S.mode==='dying'?1.58:1.52)
                       :(i===n-1?lerp(1.34,.96,frac)
                                :lerp(1.36,.98,frac)));
      drawSpriteSeg(img,px,py,size,segAngle(i,t),VARIANT_GLOW[variant],variantHot&&head);
      continue;
    }
    /* ── FALLBACK VECTORIAL ORIGINAL (se conserva íntegro) ── */
    // gradiente verde→cyan a lo largo del cuerpo
    const gr=Math.round(lerp(0,0,frac)), gc=Math.round(lerp(255,188,frac)), gb=Math.round(lerp(65,255,frac));
    let col=`rgb(${gr},${gc},${gb})`;
    if(boostOn||firewall)col='#FFD700';
    const size=head?CELL*.94:CELL*(.86-.18*frac);
    ctx.save();
    ctx.shadowColor=col; ctx.shadowBlur=head?18:8;
    ctx.fillStyle=col;
    roundRect(px+(CELL-size)/2,py+(CELL-size)/2,size,size,size*.28); ctx.fill();
    ctx.restore();
    if(head){
      // ojos según dirección
      const d=S.dir, ex=d.x*CELL*.16, ey=d.y*CELL*.16;
      const ox=d.y!==0?CELL*.16:0, oy=d.x!==0?CELL*.16:0;
      ctx.fillStyle='#02120a';
      ctx.beginPath(); ctx.arc(px+CELL/2+ex+ox,py+CELL/2+ey+oy,3.1,0,7); ctx.fill();
      ctx.beginPath(); ctx.arc(px+CELL/2+ex-ox,py+CELL/2+ey-oy,3.1,0,7); ctx.fill();
    }
  }

  // ── partículas ──
  for(const p of S.particles){
    ctx.globalAlpha=Math.max(0,p.life);
    ctx.fillStyle=p.color;
    ctx.fillRect(p.x-p.size/2,p.y-p.size/2,p.size,p.size);
  }
  ctx.globalAlpha=1;

  // ── shockwaves anulares AA (comidas jugosas / cherry bonus) ──
  for(const r of S.rings){
    ctx.save();
    ctx.globalAlpha=Math.max(0,r.life)*.9;
    ctx.strokeStyle='rgba('+r.color+',1)';
    ctx.lineWidth=r.lw*Math.max(.4,r.life);
    ctx.shadowColor='rgba('+r.color+',.9)';
    ctx.shadowBlur=12;
    ctx.beginPath(); ctx.arc(r.x,r.y,r.r,0,Math.PI*2); ctx.stroke();
    ctx.restore();
  }

  // ── popups de puntos AA (pop-in overshoot + outline + sway + glow) ──
  ctx.textAlign='center'; ctx.textBaseline='middle';
  for(const p of S.popups){
    const age=1-Math.max(0,p.life);
    const eIn=Math.min(1,age/.22);
    const scale=p.big?(eIn<.62?lerp(.45,1.42,eIn/.62):lerp(1.42,1.12,(eIn-.62)/.38))
                     :(eIn<.75?lerp(.6,1.08,eIn/.75):1.05);
    const alpha=Math.min(1,p.life*1.7);
    const sx=p.x+Math.sin(p.wob||0)*4;
    ctx.save();
    ctx.translate(sx,p.y);
    ctx.scale(scale,scale);
    ctx.globalAlpha=alpha;
    ctx.font='bold '+(p.big?34:19)+'px Orbitron,"Courier New",monospace';
    ctx.lineJoin='round';
    ctx.lineWidth=p.big?7:4;
    ctx.strokeStyle='rgba(0,0,0,.88)';
    ctx.shadowColor=p.color; ctx.shadowBlur=p.big?22:12;
    ctx.strokeText(p.text,0,0);
    ctx.fillStyle=p.big?'#FFF3B0':p.color;
    ctx.fillText(p.text,0,0);
    ctx.restore();
  }
  ctx.globalAlpha=1; ctx.shadowBlur=0; ctx.textBaseline='alphabetic';

  // ── borde de alerta firewall ──
  if(firewall){
    ctx.strokeStyle='rgba(255,215,0,'+(.4+Math.sin(now/120)*.25)+')';
    ctx.lineWidth=4; ctx.strokeRect(2,2,W-4,H-4);
  }

  // ── WHACKING DAY: tinte disco + haces rotando + borde dorado ──
  if(boostOn){
    ctx.save();
    ctx.globalCompositeOperation='lighter';
    ctx.fillStyle='rgba(255,215,0,.05)';
    ctx.fillRect(0,0,W,H);
    ctx.translate(W/2,H/2);
    for(let b=0;b<3;b++){
      ctx.save();
      ctx.rotate(now/1400+b*Math.PI*2/3);
      const grd=ctx.createLinearGradient(0,0,W*.7,0);
      grd.addColorStop(0,'rgba(255,215,0,.10)');
      grd.addColorStop(1,'rgba(255,215,0,0)');
      ctx.fillStyle=grd;
      ctx.beginPath();
      ctx.moveTo(0,0);
      ctx.arc(0,0,W,-.32,.32);
      ctx.closePath(); ctx.fill();
      ctx.restore();
    }
    ctx.restore();
    ctx.strokeStyle='rgba(255,215,0,'+(.45+Math.sin(now/110)*.3)+')';
    ctx.lineWidth=5;
    ctx.strokeRect(2,2,W-4,H-4);
  }
  ctx.restore();
}
function roundRect(x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}

// ═══════════════ AA v3 — HELPERS SPRITE / HUD / CHERRY ═══════════════
// Ángulo del segmento i según la espina interpolada de la serpiente
// (los assets miran a la DERECHA por defecto → atan2 mapea directo).
function segAngle(i,t){
  const n=S.snake.length;
  let a,b;
  if(i===0){ a=segRenderPos(0,t); b=segRenderPos(Math.min(1,n-1),t); }
  else     { a=segRenderPos(Math.max(0,i-1),t); b=segRenderPos(Math.min(n-1,i+1),t); }
  return Math.atan2(a.y-b.y,a.x-b.x);
}
const VARIANT_GLOW={'':'00FF41','_speed':'00BCFF','_invincible':'FFD700','_slow':'b26bff'};
function drawSpriteSeg(img,px,py,size,ang,glowHex,hotFlash){
  ctx.save();
  ctx.translate(px+CELL/2,py+CELL/2);
  ctx.rotate(ang);
  ctx.shadowColor='#'+(hotFlash?'ffffff':(glowHex||'00FF41'));
  ctx.shadowBlur=hotFlash?28:(size>CELL*1.45?17:10);
  ctx.drawImage(img,-size/2,-size/2,size,size);
  ctx.restore();
}
let _hpTimer=null;
function hudScorePop(gained){
  hScore.classList.remove('pop','big');
  void hScore.offsetWidth;                       // reflow para reiniciar la animación CSS
  hScore.classList.add('pop');
  if(gained>=50)hScore.classList.add('big');
  clearTimeout(_hpTimer);
  _hpTimer=setTimeout(()=>hScore.classList.remove('pop','big'),720);
}
// CHERRY BONUS: spawn programado cada 38–60s de partida + barrido de vencidas
function maybeSpawnCherry(now){
  if(S.mode!=='playing'||S.score<=0)return;
  if(!S.nextCherryAt){ S.nextCherryAt=now+CHERRY_EVERY_MIN+Math.random()*CHERRY_EVERY_RAND; return; }
  if(now>=S.nextCherryAt){
    S.nextCherryAt=now+CHERRY_EVERY_MIN+Math.random()*CHERRY_EVERY_RAND;
    const c=freeCell(5);
    if(c){ S.foods.push({...c,kind:'cherry',pts:CHERRY_PTS,color:'#FFD700',born:now,diesAt:now+CHERRY_LIFE}); sfx.power(); }
  }
  for(let i=S.foods.length-1;i>=0;i--){
    const f=S.foods[i];
    if(f.kind==='cherry'&&f.diesAt&&now>f.diesAt)S.foods.splice(i,1);
  }
}

function drawAiSnakes(){
  for(const a of S.aiSnakes){
    for(let i=a.segs.length-1;i>=0;i--){
      const s=a.segs[i];
      const size=CELL*(.62*a.scale*(i===0?1.15:1));
      ctx.save();
      ctx.globalAlpha=.85;
      ctx.shadowColor=a.color; ctx.shadowBlur=i===0?14:6;
      ctx.fillStyle=a.color;
      roundRect(s.x*CELL+(CELL-size)/2,s.y*CELL+(CELL-size)/2,size,size,size*.28);
      ctx.fill();
      ctx.restore();
    }
    // ojos de la cabeza IA
    const h=a.segs[0], size=CELL*(.62*a.scale*1.15);
    ctx.save();
    ctx.globalAlpha=.9;
    ctx.fillStyle='#02120a';
    const ex=a.dir.x*size*.18, ey=a.dir.y*size*.18;
    const ox=a.dir.y!==0?size*.18:0, oy=a.dir.x!==0?size*.18:0;
    ctx.beginPath();ctx.arc(h.x*CELL+CELL/2+ex+ox,h.y*CELL+CELL/2+ey+oy,2.4,0,7);ctx.fill();
    ctx.beginPath();ctx.arc(h.x*CELL+CELL/2+ex-ox,h.y*CELL+CELL/2+ey-oy,2.4,0,7);ctx.fill();
    ctx.restore();
  }
  ctx.globalAlpha=1;
}

// ═══════════════ LOOP PRINCIPAL ════════════════════════════
let lastFrame=performance.now();
function frame(now){
  requestAnimationFrame(frame);
  const dt=Math.min(100,now-lastFrame); lastFrame=now;

  if(S.mode==='playing'){
    S.elapsedMs=now-S.startedAt;
    // time scale (slow-mo)
    const slow=S.pu.slowmo>now;
    S.timeScale=slow?.52:1;
    // velocidad efectiva (overclock)
    const oc=S.pu.overclock>now;
    const effStep=S.stepMs/(oc?1.45:1);
    S.acc+=dt*S.timeScale;
    let guard=0;
    while(S.acc>=effStep&&guard++<4){ S.acc-=effStep; step(); if(S.mode!=='playing')break; }
    updateFx(dt);
    updateBoost(now,dt);
    maybeSpawnCherry(now);
    render(Math.min(1,S.acc/effStep));
    updatePowerupBar(now);
  }else if(S.mode==='dying'){
    updateFx(dt); render(1);
  }else{
    // intro/pausa/over: fondo animado leve
    updateFx(dt); render(0);
  }
}
requestAnimationFrame(frame);

// ═══════════════ HUD ═══════════════════════════════════════
function updateHUD(){
  hScore.textContent=S.score;
  hHi.textContent=S.hi;
  hLen.textContent=S.snake.length||4;
  hudCombo.textContent='x'+S.comboMult;
  hudCombo.classList.toggle('hot',S.comboMult>1);
}
function updatePowerupBar(now){
  const active=['overclock','firewall','slowmo'].find(k=>S.pu[k]>now);
  if(!active){ puWrap.classList.remove('on'); return; }
  puWrap.classList.add('on');
  const remain=(S.pu[active]-now)/PU_DURATION;
  puBar.className=active;
  puBar.style.width=(remain*100).toFixed(1)+'%';
}

// ═══════════════ INPUT ═════════════════════════════════════
function pushDir(x,y){
  if(S.mode==='intro'||S.mode==='over'){ startGame(); return; }
  if(S.mode!=='playing')return;
  const ref=S.queue.length?S.queue[S.queue.length-1]:S.dir;
  if(ref.x===x&&ref.y===y)return;
  if(ref.x===-x&&ref.y===-y)return;
  if(S.queue.length<2){ S.queue.push({x,y}); sfx.turn(); }
}

document.addEventListener('keydown',e=>{
  const k=e.key.toLowerCase();
  if(['arrowup','arrowdown','arrowleft','arrowright',' '].includes(k))e.preventDefault();
  if(k==='enter'||k===' '){
    if(S.mode==='intro'||S.mode==='over')startGame();
    else if(S.mode==='paused')togglePause();
    return;
  }
  if(k==='p'||k==='escape'){ togglePause(); return; }
  if(k==='w'||k==='arrowup')pushDir(0,-1);
  else if(k==='s'||k==='arrowdown')pushDir(0,1);
  else if(k==='a'||k==='arrowleft')pushDir(-1,0);
  else if(k==='d'||k==='arrowright')pushDir(1,0);
});

// swipe táctil
let tx=null,ty=null;
cv.addEventListener('touchstart',e=>{const t=e.touches[0];tx=t.clientX;ty=t.clientY;},{passive:true});
cv.addEventListener('touchend',e=>{
  if(tx===null)return;
  const t=e.changedTouches[0], dx=t.clientX-tx, dy=t.clientY-ty;
  tx=ty=null;
  if(Math.abs(dx)<22&&Math.abs(dy)<22){ if(S.mode==='intro'||S.mode==='over')startGame(); return; }
  if(Math.abs(dx)>Math.abs(dy))pushDir(dx>0?1:-1,0);
  else pushDir(0,dy>0?1:-1);
},{passive:true});

// botones UI
$('btnStart').addEventListener('click',startGame);
$('btnRetry').addEventListener('click',startGame);
$('btnResume').addEventListener('click',togglePause);
$('introBlink').parentElement.addEventListener('click',()=>{if(S.mode==='intro')startGame();});

// FIX CRÍTICO: el viejo listener de 'blur' pausaba el juego cada vez
// que el usuario tocaba cualquier botón del HUD del padre (boost WHACK
// incluido), porque el iframe pierde foco al hacer click fuera de él.
// Ahora solo se pausa cuando la pestaña se oculta realmente.
document.addEventListener('visibilitychange',()=>{ if(document.hidden&&S.mode==='playing')togglePause(); });

// ═══════════════ PUENTE CON EL PADRE (arena iframe) ════════
function postParent(msg){ try{ if(window.parent&&window.parent!==window)window.parent.postMessage(msg,'*'); }catch(e){} }
// D-PAD del padre: acepta varias formas de mensaje
window.addEventListener('message',ev=>{
  const d=ev.data; if(!d||typeof d!=='object')return;
  const dirMap={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]};
  let dir=null;
  if(d.type==='FP_INPUT'&&dirMap[d.dir])dir=dirMap[d.dir];
  else if(d.type==='FP_KEY'&&dirMap[String(d.key||'').toLowerCase().replace('arrow','')])dir=dirMap[String(d.key||'').toLowerCase().replace('arrow','')];
  else if(dirMap[d.dir])dir=dirMap[d.dir];
  else if(typeof d.key==='string'&&dirMap[d.key.toLowerCase().replace('arrow','')])dir=dirMap[d.key.toLowerCase().replace('arrow','')];
  if(dir)pushDir(dir[0],dir[1]);
  // WHACKING DAY / TRIGGER_BOOST: ambos nombres aceptados como disparador
  if((d.type==='WHACKING_DAY'||d.type==='TRIGGER_BOOST')&&S.mode==='playing')activateSnakeBoost();
  if(d.type==='FP_PAUSE'||(d.type==='FP_CMD'&&d.cmd==='pause'))togglePause();
  // START_MATCH: arranque sincronizado multijugador desde la arena
  if(d.type==='START_MATCH'){
    if(S.mode==='intro'||S.mode==='over')startGame();
    else if(S.mode==='paused')togglePause();
  }
  // MATCH_ENDED: la arena corta la partida (timer agotado)
  if(d.type==='MATCH_ENDED'&&S.mode==='playing')gameOver();
  // SET_CONTROL: swipe es táctil nativo; dpad consume KEY_DOWN de abajo
  if(d.type==='SET_CONTROL')S.controlMode=d.mode||'swipe';
  // KEY_DOWN del D-PAD del padre (mobile)
  if(d.type==='KEY_DOWN'){
    const km={ArrowUp:[0,-1],ArrowDown:[0,1],ArrowLeft:[-1,0],ArrowRight:[1,0]};
    const v=km[d.key]||km[String(d.key||'').toLowerCase()];
    if(v)pushDir(v[0],v[1]);
  }
});

// init HUD
updateHUD();
postParent({type:'FP_GAME_STATE',state:'ready'});
</script>
